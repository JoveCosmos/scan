# Authored on Windows, run on Linux. A CRLF shebang makes the kernel fail the
# script with "bad interpreter", and systemd/nginx units are equally unhappy,
# so force LF for everything the server executes or parses.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf

# Keep source normalised too, so diffs stay clean across machines.
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.json          text eol=lf
*.css           text eol=lf
*.md            text eol=lf

*.ico           binary
*.jpg           binary
*.png           binary
*.svg           text eol=lf

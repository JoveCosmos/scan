# Anything executed on the server must keep LF endings regardless of the
# platform it was edited on. A CRLF shebang fails as "bad interpreter: no such
# file or directory", which names the interpreter that plainly does exist and
# sends you looking in the wrong place entirely.
*.sh            text eol=lf
deploy/scan-dev text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
*.sql           text eol=lf

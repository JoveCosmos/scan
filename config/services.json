{
  "chains": [
    {
      "chainId": "atomone-1",
      "daemon": "atomoned",
      "home": "$HOME/.atomone",
      "endpoints": [
        {
          "label": "RPC",
          "url": "https://atomone-rpc.gatadao.com",
          "kind": "rpc"
        },
        {
          "label": "REST / API",
          "url": "https://atomone-api.gatadao.com",
          "kind": "rest"
        }
      ],
      "snapshot": {
        "schedule": "daily at 06:20 UTC",
        "pruning": "custom (100/0/10), no tx index",
        "note": "Pruned for fast sync, not for historical queries: a restored node keeps ~1000 blocks and rebuilds its transaction index going forward. Every archive is verified before publication by booting a throwaway node against it."
      },
      "snapshotKey": "atomone"
    },
    {
      "chainId": "atomone-testnet-1",
      "daemon": "atomoned",
      "home": "$HOME/.atomone",
      "endpoints": [
        {
          "label": "RPC",
          "url": "https://atomone-testnet-rpc.gatadao.com",
          "kind": "rpc"
        },
        {
          "label": "REST / API",
          "url": "https://atomone-testnet-api.gatadao.com",
          "kind": "rest"
        }
      ],
      "snapshot": {
        "schedule": "daily at 05:50 UTC",
        "pruning": "custom (100/0/10), no tx index",
        "note": "Pruned for fast sync, not for historical queries: a restored node keeps ~1000 blocks and rebuilds its transaction index going forward. Every archive is verified before publication by booting a throwaway node against it."
      },
      "snapshotKey": "atomone-testnet"
    },
    {
      "chainId": "sapphire-1",
      "daemon": "gnoland",
      "home": "$HOME/.gnoland",
      "endpoints": [
        {
          "label": "RPC",
          "url": "https://gnoland-testnet-rpc.gatadao.com",
          "kind": "rpc"
        }
      ],
      "snapshot": {
        "status": "planned",
        "schedule": "daily at 02:00 UTC",
        "pruning": "archive",
        "note": "Not published yet."
      }
    },
    {
      "chainId": "juno-1",
      "daemon": "junod",
      "home": "$HOME/.juno",
      "snapshotKey": "juno",
      "snapshot": {
        "schedule": "daily at 05:30 UTC",
        "pruning": "custom (100/0/10), no tx index",
        "note": "Pruned for fast sync, not for historical queries: a restored node keeps ~1000 blocks and rebuilds its transaction index going forward. Every archive is verified before publication by booting a throwaway node against it."
      }
    }
  ]

[Unit]
Description=GATA HUB Explorer (Next.js)
Documentation=https://github.com/JoveCosmos/explorer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated account. Deliberately NOT the gata user: that account can read
# /etc/gata/app.env (root:gata 0640), so running a public-facing explorer as
# gata would put gata-hub's secrets one compromise away.
User=explorer
Group=explorer
WorkingDirectory=/srv/explorer/current

Environment=NODE_ENV=production
Environment=PORT=3200
# Loopback only — nginx is the sole way in.
Environment=HOSTNAME=127.0.0.1
Environment=HOME=/srv/explorer
Environment=npm_config_cache=/srv/explorer/shared/.npm
# Realm index lives in shared/ so a release swap never discards it.
Environment=VALOPER_CACHE_DIR=/srv/explorer/shared/valopers

ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
# The startup warm makes ~96 serialised realm calls before the app is ready.
TimeoutStartSec=120

# --- Filesystem isolation -------------------------------------------------
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/explorer
PrivateTmp=true
# Explicitly out of reach even if ownership is ever loosened by mistake.
InaccessiblePaths=/srv/gata-hub /etc/gata

# --- Privilege and kernel isolation ---------------------------------------
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Outbound HTTPS to public chain nodes, plus the loopback listener.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# NOTE: MemoryDenyWriteExecute is intentionally NOT set — it breaks V8's JIT
# and Node will not start.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=explorer

[Install]
WantedBy=multi-user.target

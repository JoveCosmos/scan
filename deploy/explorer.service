[Unit]
Description=GATA HUB Explorer (Next.js)
Documentation=https://github.com/JoveCosmos/explorer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=explorer
Group=explorer
WorkingDirectory=/srv/explorer

Environment=NODE_ENV=production
Environment=PORT=3200
# Bind to loopback only — nginx is the only thing that should reach it.
Environment=HOSTNAME=127.0.0.1
# Keeps the valopers realm index outside the app dir so a deploy cannot wipe it.
Environment=VALOPER_CACHE_DIR=/var/lib/explorer/valopers

ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

# The startup warm makes ~96 realm calls before it is ready; do not let a slow
# node look like a failed boot.
TimeoutStartSec=120

# Hardening: the app only needs to read its own directory and write its cache.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/explorer/.next /var/lib/explorer

StandardOutput=journal
StandardError=journal
SyslogIdentifier=explorer

[Install]
WantedBy=multi-user.target

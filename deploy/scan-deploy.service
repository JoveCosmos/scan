[Unit]
Description=Pull and rebuild Scan if git moved
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scan
Group=scan
WorkingDirectory=/srv/scan/repo

Environment=ROOT=/srv/scan
Environment=BRANCH=master
Environment=SERVICE=scan
Environment=HOME=/srv/scan
Environment=npm_config_cache=/srv/scan/shared/.npm

ExecStart=/opt/scan/deploy.sh
# npm ci plus next build on a small box.
TimeoutStartSec=900

# Builds need to write the release tree, but nothing outside it.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/scan
PrivateTmp=true
InaccessiblePaths=/srv/gata-hub /etc/gata

# Must stay false: deploy.sh calls sudo to restart the app, and sudo is setuid,
# which NoNewPrivileges blocks outright. The app service itself sets it true —
# that is the process actually exposed to the internet.
NoNewPrivileges=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=scan-deploy

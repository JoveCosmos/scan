[Unit]
Description=GATA SCAN (Next.js)
Documentation=https://github.com/JoveCosmos/scan
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated account. Deliberately NOT the gata user: that account can read
# /etc/gata/app.env (root:gata 0640), so running a public-facing scan as
# gata would put gata-hub's secrets one compromise away.
User=scan
Group=scan
WorkingDirectory=/srv/scan/current

Environment=NODE_ENV=production
Environment=HOME=/srv/scan
Environment=npm_config_cache=/srv/scan/shared/.npm
# Realm index lives in shared/ so a release swap never discards it.
Environment=VALOPER_CACHE_DIR=/srv/scan/shared/valopers

# Secrets - currently INDEXER_DATABASE_URL, the read-only role on the indexer's
# Postgres. A file rather than Environment= above, because unit files are world
# readable and `systemctl cat scan` would hand the credential to any account
# on the box.
#
# systemd reads this as root while setting the unit up, before the namespace
# below takes effect, so InaccessiblePaths=/etc/gata does not conflict with it -
# the value arrives as an environment variable and the running process has no
# path to the file it came from. Keep it root:scan 0640.
#
# Leading '-' makes it optional: Scan must still start on a box where
# the indexer was never configured, which is the same fallback the read path
# assumes.
EnvironmentFile=-/etc/gata/scan.env

# Bind explicitly on the command line. The HOSTNAME env var did NOT restrict
# next start - it still listened on 0.0.0.0, which would expose port 3200
# directly to the internet and bypass nginx. --hostname is authoritative.
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3200
Restart=always
RestartSec=5
# The startup warm makes ~96 serialised realm calls before the app is ready.
TimeoutStartSec=120

# --- Filesystem isolation -------------------------------------------------
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/scan
PrivateTmp=true
# Explicitly out of reach even if ownership is ever loosened by mistake.
InaccessiblePaths=/srv/gata-hub /etc/gata

# --- Privilege and kernel isolation ---------------------------------------
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Outbound HTTPS to public chain nodes, plus the loopback listener.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# NOTE: MemoryDenyWriteExecute is intentionally NOT set - it breaks V8's JIT
# and Node will not start.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=scan

[Install]
WantedBy=multi-user.target
